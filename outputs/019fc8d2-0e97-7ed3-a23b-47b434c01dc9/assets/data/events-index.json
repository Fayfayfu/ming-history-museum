{"version":1,"stages":[{"id":"s1","label":"洪武建国与高压国家","range":"1368—1398","start":1368,"end":1398,"thesis":"统一战争与制度重建并行，皇权直接统辖行政、军事和基层社会。"},{"id":"s2","label":"靖难与永乐扩张","range":"1398—1435","start":1398,"end":1435,"thesis":"削藩失败引发内战，永乐朝以迁都、北征、下西洋和宫廷新机构重塑帝国。"},{"id":"s3","label":"土木堡后的政治重组","range":"1435—1505","start":1435,"end":1505,"thesis":"皇帝被俘并未摧毁国家，但促成军事调整、文官政治扩张与厂卫反复。"},{"id":"s4","label":"正德嘉靖：礼制与边海危机","range":"1505—1567","start":1505,"end":1567,"thesis":"皇权表达、礼制冲突、北部边患与东南海防危机同时加深。"},{"id":"s5","label":"隆万改革与全球联系","range":"1567—1620","start":1567,"end":1620,"thesis":"开放海贸、白银财政、张居正改革和大规模战争共同塑造晚明国家。"},{"id":"s6","label":"危机、北京陷落与南明","range":"1620—1662","start":1620,"end":1662,"thesis":"辽东战争、财政崩解、民变与明清竞争叠加；1644不是明政治传统的即时终点。"}],"events":[{"id":"e001","year":1368,"date":"1368年正月","eraDate":"洪武元年正月","title":"朱元璋建立明朝","stage":"s1","category":"政权更替","emperor":"洪武帝","location":"南京","people":["朱元璋","李善长","刘基","徐达"],"institutions":["皇帝制度","南京六部"],"confidence":"高","detailUrl":"assets/data/event-details/e001.json","eraYear":"洪武元年","cause":"元末战争中朱元璋集团已控制长江中下游并击败主要竞争者。","impact":"成为此后近三百年制度与政治秩序的起点。"},{"id":"e002","year":1368,"date":"1368年八月","eraDate":"洪武元年八月","title":"明军攻占大都","stage":"s1","category":"战争","emperor":"洪武帝","location":"大都／北平","people":["徐达","常遇春","朱元璋"],"institutions":["北伐军","北平都司"],"confidence":"高","detailUrl":"assets/data/event-details/e002.json","eraYear":"洪武元年","cause":"明军北伐旨在夺取元朝政治中心并控制华北。","impact":"明朝取得华北核心地区，但北元仍长期构成北部威胁。"},{"id":"e003","year":1370,"date":"1370年","eraDate":"洪武三年","title":"首次大规模分封诸王","stage":"s1","category":"制度","emperor":"洪武帝","location":"全国藩府","people":["朱元璋","朱棣","朱权"],"institutions":["宗藩制度","王府护卫"],"confidence":"高","detailUrl":"assets/data/event-details/e003.json","eraYear":"洪武三年","cause":"皇帝希望依靠宗室镇守要地并拱卫皇权。","impact":"加强边地控制，也为建文削藩和靖难之役埋下制度矛盾。"},{"id":"e004","year":1371,"date":"1371年","eraDate":"洪武四年","title":"平定明夏、控制四川","stage":"s1","category":"战争","emperor":"洪武帝","location":"四川","people":["傅友德","汤和","朱元璋"],"institutions":["征西军","四川布政使司"],"confidence":"高","detailUrl":"assets/data/event-details/e004.json","eraYear":"洪武四年","cause":"明夏政权控制四川，阻碍全国统一。","impact":"西南统一取得关键进展，并为进取云南创造条件。"},{"id":"e005","year":1375,"date":"1375年","eraDate":"洪武八年","title":"发行大明宝钞","stage":"s1","category":"财政经济","emperor":"洪武帝","location":"全国","people":["朱元璋"],"institutions":["宝钞提举司","户部"],"confidence":"高","detailUrl":"assets/data/event-details/e005.json","eraYear":"洪武八年","cause":"新王朝需要统一货币并降低金属货币供给压力。","impact":"因缺乏稳定兑换与增发，后续持续贬值，显示行政货币的局限。"},{"id":"e006","year":1376,"date":"1376年","eraDate":"洪武九年","title":"改行省为承宣布政使司","stage":"s1","category":"制度","emperor":"洪武帝","location":"各省","people":["朱元璋"],"institutions":["布政使司","按察使司","都指挥使司"],"confidence":"高","detailUrl":"assets/data/event-details/e006.json","eraYear":"洪武九年","cause":"皇帝警惕元代行省长官权力集中。","impact":"强化中央控制，也造成地方事务需要多机构协调。"},{"id":"e007","year":1380,"date":"1380年","eraDate":"洪武十三年","title":"胡惟庸案与废除丞相","stage":"s1","category":"制度","emperor":"洪武帝","location":"南京","people":["朱元璋","胡惟庸","李善长"],"institutions":["中书省","六部","内阁前史"],"confidence":"高","detailUrl":"assets/data/event-details/e007.json","eraYear":"洪武十三年","cause":"皇帝与中书省、丞相之间长期存在权力冲突。","impact":"皇帝决策负担显著增加，后来的内阁在无宰相名义下承担票拟与协调。"},{"id":"e008","year":1381,"date":"1381—1382年","eraDate":"洪武十四年至十五年","title":"明军征服云南","stage":"s1","category":"战争","emperor":"洪武帝","location":"云南","people":["傅友德","蓝玉","沐英","朱元璋"],"institutions":["云南布政使司","卫所","土司"],"confidence":"高","detailUrl":"assets/data/event-details/e008.json","eraYear":"洪武十四年","cause":"元朝残余势力仍控制云南，西南统一尚未完成。","impact":"推动卫所、移民与土司并行的西南治理格局。"},{"id":"e009","year":1385,"date":"1385年","eraDate":"洪武十八年","title":"郭桓案与财政肃贪","stage":"s1","category":"财政经济","emperor":"洪武帝","location":"南京及地方","people":["朱元璋","郭桓"],"institutions":["户部","监察体系"],"confidence":"中","detailUrl":"assets/data/event-details/e009.json","eraYear":"洪武十八年","cause":"中央发现户部与地方官员在粮税、账册中存在大规模舞弊。","impact":"短期震慑贪污，却也扩大株连和行政恐惧；涉案规模在史籍中存在争议。"},{"id":"e010","year":1387,"date":"1387年","eraDate":"洪武二十年","title":"纳哈出降明、辽东形势改变","stage":"s1","category":"战争","emperor":"洪武帝","location":"辽东／东北","people":["冯胜","蓝玉","朱元璋"],"institutions":["辽东都司","卫所"],"confidence":"高","detailUrl":"assets/data/event-details/e010.json","eraYear":"洪武二十年","cause":"北元势力以辽东和东北为活动基地，威胁明朝边防。","impact":"为次年深入漠北作战提供条件，也推动辽东卫所扩展。"},{"id":"e011","year":1388,"date":"1388年","eraDate":"洪武二十一年","title":"捕鱼儿海之战","stage":"s1","category":"战争","emperor":"洪武帝","location":"捕鱼儿海","people":["蓝玉","朱元璋"],"institutions":["北征军","边防体系"],"confidence":"高","detailUrl":"assets/data/event-details/e011.json","eraYear":"洪武二十一年","cause":"明廷试图打击北元汗廷及其军事组织。","impact":"洪武朝北部军事扩张达到高点，但草原政治力量并未消失。"},{"id":"e012","year":1392,"date":"1392年","eraDate":"洪武二十五年","title":"太子朱标去世","stage":"s1","category":"政权更替","emperor":"洪武帝","location":"南京","people":["朱标","朱允炆","朱元璋","朱棣"],"institutions":["皇储制度","宗藩制度"],"confidence":"高","detailUrl":"assets/data/event-details/e012.json","eraYear":"洪武二十五年","cause":"皇太子朱标病逝，原定继承安排中断。","impact":"继承结构与强藩并存，成为削藩和靖难冲突的直接背景。"},{"id":"e013","year":1393,"date":"1393年","eraDate":"洪武二十六年","title":"蓝玉案","stage":"s1","category":"政治","emperor":"洪武帝","location":"南京","people":["蓝玉","朱元璋","朱允炆"],"institutions":["勋贵集团","锦衣卫"],"confidence":"中","detailUrl":"assets/data/event-details/e013.json","eraYear":"洪武二十六年","cause":"皇帝持续防范开国武将集团和潜在政治联盟。","impact":"皇权更集中，但年轻继承人失去一批有经验的军事支持者。"},{"id":"e014","year":1397,"date":"1397年","eraDate":"洪武三十年","title":"《大明律》定型颁行","stage":"s1","category":"制度","emperor":"洪武帝","location":"全国","people":["朱元璋"],"institutions":["大明律","刑部","都察院","大理寺"],"confidence":"高","detailUrl":"assets/data/event-details/e014.json","eraYear":"洪武三十年","cause":"新王朝需要统一长期适用的刑律和行政规范。","impact":"对明代司法及后续清律产生深远影响，但诏令和大诰仍可能改变具体执法。"},{"id":"e015","year":1398,"date":"1398年","eraDate":"洪武三十一年","title":"洪武帝去世、建文帝继位","stage":"s1","category":"政权更替","emperor":"建文帝","location":"南京","people":["朱元璋","朱允炆","方孝孺"],"institutions":["皇位继承","宗藩制度"],"confidence":"高","detailUrl":"assets/data/event-details/e015.json","eraYear":"洪武三十一年","cause":"朱元璋去世，皇太孙朱允炆依既定安排继承皇位。","impact":"从开国皇帝个人统治转入继承危机，洪武制度的内在张力迅速暴露。"},{"id":"e016","year":1398,"date":"1398—1399年","eraDate":"洪武三十一年至建文元年","title":"建文削藩","stage":"s2","category":"政治","emperor":"建文帝","location":"南京及各藩府","people":["朱允炆","朱棣","方孝孺"],"institutions":["宗藩制度","王府护卫"],"confidence":"高","detailUrl":"assets/data/event-details/e016.json","eraYear":"洪武三十一年","cause":"多位叔王拥有护卫和地方影响，威胁年轻皇帝的中央权威。","impact":"策略次序和执行方式促成燕王起兵，削藩目标反而失败。"},{"id":"e017","year":1399,"date":"1399年","eraDate":"建文元年","title":"靖难之役爆发","stage":"s2","category":"战争","emperor":"建文帝","location":"北平及华北","people":["朱棣","朱允炆","姚广孝","李景隆"],"institutions":["燕王护卫","中央军"],"confidence":"高","detailUrl":"assets/data/event-details/e017.json","eraYear":"建文元年","cause":"燕王以“清君侧”为名反对削藩和中央处置。","impact":"重塑皇位合法性、军事集团和南北政治格局。"},{"id":"e018","year":1402,"date":"1402年六月","eraDate":"建文四年六月","title":"南京陷落与永乐帝即位","stage":"s2","category":"政权更替","emperor":"永乐帝","location":"南京","people":["朱棣","朱允炆","方孝孺","姚广孝"],"institutions":["皇位继承","诏狱"],"confidence":"高","detailUrl":"assets/data/event-details/e018.json","eraYear":"建文四年","cause":"靖难军突破南方防线并逼近京师。","impact":"永乐朝通过改史、惩处建文臣僚和重新配置官僚巩固新合法性。"},{"id":"e019","year":1403,"date":"1403年","eraDate":"永乐元年","title":"北平升为北京","stage":"s2","category":"制度","emperor":"永乐帝","location":"北京","people":["朱棣"],"institutions":["北京行部","两京制度"],"confidence":"高","detailUrl":"assets/data/event-details/e019.json","eraYear":"永乐元年","cause":"朱棣的政治与军事根基在北方，北边防务亦需长期经营。","impact":"为迁都和此后两京制度奠定基础。"},{"id":"e020","year":1405,"date":"1405年","eraDate":"永乐三年","title":"郑和首次下西洋","stage":"s2","category":"对外关系","emperor":"永乐帝","location":"东南亚与印度洋","people":["郑和","朱棣"],"institutions":["宝船舰队","朝贡体系"],"confidence":"高","detailUrl":"assets/data/event-details/e020.json","eraYear":"永乐三年","cause":"永乐朝希望扩展朝贡网络、展示新政权威望并保障海上交往。","impact":"扩大外交、贸易和海洋知识，但其财政与政治目标长期存在讨论。"},{"id":"e021","year":1406,"date":"1406—1407年","eraDate":"永乐四年至五年","title":"明军征服安南并设交趾","stage":"s2","category":"战争","emperor":"永乐帝","location":"安南／交趾","people":["朱棣","张辅"],"institutions":["交趾布政使司","征夷军"],"confidence":"高","detailUrl":"assets/data/event-details/e021.json","eraYear":"永乐四年","cause":"安南胡氏政权更替、陈氏复立争议与明廷干预升级。","impact":"长期驻军和征敛激起反抗，最终导致明朝撤退。"},{"id":"e022","year":1408,"date":"1408年","eraDate":"永乐六年","title":"《永乐大典》完成","stage":"s2","category":"文化科技","emperor":"永乐帝","location":"南京","people":["解缙","姚广孝","朱棣"],"institutions":["翰林院","国家修书"],"confidence":"高","detailUrl":"assets/data/event-details/e022.json","eraYear":"永乐六年","cause":"朝廷试图汇聚经史子集及各类知识，服务皇权文化工程。","impact":"保存大量后世散佚文献，也显示永乐朝动员知识与人力的能力。"},{"id":"e023","year":1410,"date":"1410年","eraDate":"永乐八年","title":"永乐帝首次亲征蒙古","stage":"s2","category":"战争","emperor":"永乐帝","location":"漠北","people":["朱棣"],"institutions":["京营","北部边防"],"confidence":"高","detailUrl":"assets/data/event-details/e023.json","eraYear":"永乐八年","cause":"蒙古诸部联盟与边境安全问题持续存在。","impact":"开启多次皇帝亲征，强化北京的边防中心地位，也耗费巨大。"},{"id":"e024","year":1415,"date":"1415年前后","eraDate":"永乐十三年前后","title":"大运河整治与漕运北上","stage":"s2","category":"财政经济","emperor":"永乐帝","location":"大运河沿线","people":["朱棣","宋礼"],"institutions":["漕运","工部","漕运总督"],"confidence":"中","detailUrl":"assets/data/event-details/e024.json","eraYear":"永乐十三年","cause":"北京建设和北方军政人口需要稳定的大规模粮食供应。","impact":"形成连接江南财政与北京政治中心的国家生命线。"},{"id":"e025","year":1420,"date":"1420年","eraDate":"永乐十八年","title":"北京宫城完成并设东厂","stage":"s2","category":"制度","emperor":"永乐帝","location":"北京","people":["朱棣"],"institutions":["紫禁城","东厂","锦衣卫"],"confidence":"高","detailUrl":"assets/data/event-details/e025.json","eraYear":"永乐十八年","cause":"迁都工程需要新的宫城，同时皇帝希望拥有直接控制的侦缉力量。","impact":"北京成为权力核心，宦官侦缉机构进入明代政治结构。"},{"id":"e026","year":1421,"date":"1421年","eraDate":"永乐十九年","title":"正式迁都北京","stage":"s2","category":"制度","emperor":"永乐帝","location":"北京／南京","people":["朱棣"],"institutions":["两京制度","漕运","北京六部"],"confidence":"高","detailUrl":"assets/data/event-details/e026.json","eraYear":"永乐十九年","cause":"北方边防、朱棣政治根基和新宫城完工共同推动迁都。","impact":"国家安全更直接面向蒙古边疆，财政则更加依赖南粮北运。"},{"id":"e027","year":1424,"date":"1424年","eraDate":"永乐二十二年","title":"永乐帝北征途中去世","stage":"s2","category":"政权更替","emperor":"洪熙帝","location":"榆木川／北京","people":["朱棣","朱高炽","杨士奇","杨荣","杨溥"],"institutions":["内阁","皇位继承"],"confidence":"高","detailUrl":"assets/data/event-details/e027.json","eraYear":"永乐二十二年","cause":"永乐帝第五次北征期间病逝。","impact":"虽在位不足一年，仍为仁宣政治奠定方向。"},{"id":"e028","year":1425,"date":"1425年","eraDate":"洪熙元年","title":"宣德帝继位与仁宣治理延续","stage":"s2","category":"政权更替","emperor":"宣德帝","location":"北京","people":["朱瞻基","朱高炽","杨士奇","杨荣","杨溥"],"institutions":["内阁","皇位继承"],"confidence":"高","detailUrl":"assets/data/event-details/e028.json","eraYear":"洪熙元年","cause":"洪熙帝突然去世，皇太子朱瞻基继位。","impact":"后世常以“仁宣之治”概括这一阶段，但其评价仍需结合财政和边防成本。"},{"id":"e029","year":1427,"date":"1427年","eraDate":"宣德二年","title":"明朝撤出交趾","stage":"s2","category":"对外关系","emperor":"宣德帝","location":"安南","people":["朱瞻基","黎利"],"institutions":["交趾布政使司","朝贡体系"],"confidence":"高","detailUrl":"assets/data/event-details/e029.json","eraYear":"宣德二年","cause":"黎利领导的长期反抗使明军驻守成本不断上升。","impact":"显示军事占领与地方治理的成本边界，朝贡关系取代直接统治。"},{"id":"e030","year":1431,"date":"1431—1433年","eraDate":"宣德六年至八年","title":"郑和第七次下西洋及航海终止","stage":"s2","category":"对外关系","emperor":"宣德帝","location":"印度洋","people":["郑和","朱瞻基"],"institutions":["宝船舰队","朝贡体系"],"confidence":"高","detailUrl":"assets/data/event-details/e030.json","eraYear":"宣德六年","cause":"宣德朝恢复一度中断的远洋使团。","impact":"海上朝贡网络仍存在，但财政、边防与政策重心转向内陆和近海。"},{"id":"e031","year":1435,"date":"1435年","eraDate":"宣德十年","title":"英宗幼年即位与辅政格局","stage":"s3","category":"政治","emperor":"正统帝","location":"北京","people":["朱祁镇","杨士奇","杨荣","杨溥","王振"],"institutions":["内阁","司礼监"],"confidence":"高","detailUrl":"assets/data/event-details/e031.json","eraYear":"宣德十年","cause":"宣德帝去世时朱祁镇年仅八岁。","impact":"随着旧臣退出，王振影响扩大，为1449年决策环境提供背景。"},{"id":"e032","year":1447,"date":"1447—1450年","eraDate":"正统十二年至景泰元年","title":"闽浙矿徒与邓茂七起事","stage":"s3","category":"社会","emperor":"正统帝","location":"福建、浙江、江西交界","people":["邓茂七"],"institutions":["里甲","矿禁","地方军"],"confidence":"高","detailUrl":"assets/data/event-details/e032.json","eraYear":"正统十二年","cause":"银矿禁采、租佃负担和地方社会矛盾叠加。","impact":"暴露山区矿业、流动人口和基层征役难以纳入传统户籍控制。"},{"id":"e033","year":1449,"date":"1449年八月","eraDate":"正统十四年八月","title":"土木堡之变","stage":"s3","category":"战争","emperor":"正统帝","location":"土木堡","people":["朱祁镇","王振","于谦"],"institutions":["京营","司礼监","兵部"],"confidence":"高","detailUrl":"assets/data/event-details/e033.json","eraYear":"正统十四年","cause":"瓦剌与明朝在贡赐、边贸和边境政治上的矛盾升级。","impact":"制造空前皇位危机，也迫使明廷重建北京防务与决策机制。"},{"id":"e034","year":1449,"date":"1449年九月","eraDate":"正统十四年九月","title":"郕王即位、改元景泰","stage":"s3","category":"政权更替","emperor":"景泰帝","location":"北京","people":["朱祁钰","朱祁镇","于谦"],"institutions":["皇位继承","太上皇制度"],"confidence":"高","detailUrl":"assets/data/event-details/e034.json","eraYear":"正统十四年","cause":"英宗被俘，明廷需要拥有完整名义的君主主持战争和政务。","impact":"解决即时合法性问题，却留下两位在世皇帝并存的继承冲突。"},{"id":"e035","year":1449,"date":"1449年十月—十一月","eraDate":"正统十四年十月—十一月","title":"北京保卫战","stage":"s3","category":"战争","emperor":"景泰帝","location":"北京","people":["于谦","朱祁钰","朱祁镇","石亨"],"institutions":["兵部","京营","城防"],"confidence":"高","detailUrl":"assets/data/event-details/e035.json","eraYear":"正统十四年","cause":"也先挟英宗南下，试图迫使明朝让步并夺取北京。","impact":"证明国家并未因皇帝被俘而瓦解，文官主导的战时动员获得威望。"},{"id":"e036","year":1450,"date":"1450年","eraDate":"景泰元年","title":"英宗获释返京","stage":"s3","category":"对外关系","emperor":"景泰帝","location":"北京","people":["朱祁镇","朱祁钰"],"institutions":["太上皇制度","南宫"],"confidence":"高","detailUrl":"assets/data/event-details/e036.json","eraYear":"景泰元年","cause":"瓦剌无法借被俘皇帝获得预期政治利益，明瓦关系转向议和。","impact":"为1457年复辟积累宫廷和政治条件。"},{"id":"e037","year":1457,"date":"1457年正月","eraDate":"天顺元年正月","title":"夺门之变","stage":"s3","category":"政权更替","emperor":"天顺帝","location":"北京","people":["朱祁镇","朱祁钰","于谦","石亨","徐有贞","曹吉祥"],"institutions":["皇位继承","宫廷政变"],"confidence":"高","detailUrl":"assets/data/event-details/e037.json","eraYear":"天顺元年","cause":"景泰帝病重且储位不稳，石亨、徐有贞、曹吉祥等谋求政治机会。","impact":"于谦被杀，复辟功臣迅速掌权；“正统—景泰—天顺”成为特殊双重皇位周期。"},{"id":"e038","year":1461,"date":"1461年","eraDate":"天顺五年","title":"曹石之变","stage":"s3","category":"政治","emperor":"天顺帝","location":"北京","people":["曹吉祥","曹钦","朱祁镇"],"institutions":["京营","宫廷政变"],"confidence":"高","detailUrl":"assets/data/event-details/e038.json","eraYear":"天顺五年","cause":"复辟功臣集团权势膨胀，曹吉祥、曹钦担忧被清算。","impact":"英宗清理夺门功臣，宫廷重新调整勋贵、武将与宦官权力。"},{"id":"e039","year":1464,"date":"1464年","eraDate":"天顺八年","title":"成化帝继位","stage":"s3","category":"政权更替","emperor":"成化帝","location":"北京","people":["朱见深","于谦","汪直"],"institutions":["皇位继承","厂卫"],"confidence":"高","detailUrl":"assets/data/event-details/e039.json","eraYear":"天顺八年","cause":"英宗去世，太子朱见深继位。","impact":"成化朝同时出现宽复旧案与厂卫扩张的两面性。"},{"id":"e040","year":1477,"date":"1477年","eraDate":"成化十三年","title":"设立西厂","stage":"s3","category":"制度","emperor":"成化帝","location":"北京及全国","people":["朱见深","汪直"],"institutions":["西厂","东厂","锦衣卫"],"confidence":"高","detailUrl":"assets/data/event-details/e040.json","eraYear":"成化十三年","cause":"皇帝希望扩大对官僚和社会信息的直接掌握。","impact":"显示临时皇帝直属机构可绕过常规司法和行政程序。"},{"id":"e041","year":1482,"date":"1482年","eraDate":"成化十八年","title":"西厂被废","stage":"s3","category":"制度","emperor":"成化帝","location":"北京","people":["朱见深","汪直"],"institutions":["西厂","厂卫"],"confidence":"高","detailUrl":"assets/data/event-details/e041.json","eraYear":"成化十八年","cause":"汪直失势，西厂滥权引发持续反对。","impact":"厂卫并非始终稳定存在，而是随皇帝信任和宫廷斗争反复开废。"},{"id":"e042","year":1487,"date":"1487年","eraDate":"成化二十三年","title":"弘治帝继位与政治整顿","stage":"s3","category":"政治","emperor":"弘治帝","location":"北京","people":["朱祐樘","刘健","谢迁","李东阳"],"institutions":["内阁","六部"],"confidence":"高","detailUrl":"assets/data/event-details/e042.json","eraYear":"成化二十三年","cause":"成化帝去世，朱祐樘继位并试图纠正前朝弊政。","impact":"形成“弘治中兴”的传统评价，但并未消除财政、边防与土地问题。"},{"id":"e043","year":1497,"date":"1497年","eraDate":"弘治十年","title":"敕修《大明会典》","stage":"s3","category":"制度","emperor":"弘治帝","location":"北京","people":["朱祐樘","刘健","李东阳"],"institutions":["大明会典","六部","内阁"],"confidence":"高","detailUrl":"assets/data/event-details/e043.json","eraYear":"弘治十年","cause":"洪武以来制度事例分散，中央各司查考困难。","impact":"把不断变化的明代行政规则整理成可检索的机构知识。"},{"id":"e044","year":1502,"date":"1502年","eraDate":"弘治十五年","title":"弘治《大明会典》修成","stage":"s3","category":"制度","emperor":"弘治帝","location":"北京","people":["朱祐樘","李东阳","刘健"],"institutions":["大明会典","国家修书"],"confidence":"高","detailUrl":"assets/data/event-details/e044.json","eraYear":"弘治十五年","cause":"历时五年的典章汇编完成。","impact":"成为正德刊本及万历重修会典的基础。"},{"id":"e045","year":1505,"date":"1505年","eraDate":"弘治十八年","title":"正德帝继位","stage":"s3","category":"政权更替","emperor":"正德帝","location":"北京","people":["朱厚照","刘瑾","刘健","谢迁","李东阳"],"institutions":["内阁","司礼监","八虎"],"confidence":"高","detailUrl":"assets/data/event-details/e045.json","eraYear":"弘治十八年","cause":"弘治帝去世，十五岁的朱厚照继位。","impact":"宦官专权、皇帝个人行动和文官抗争成为正德政治主线。"},{"id":"e046","year":1506,"date":"1506年","eraDate":"正德元年","title":"刘瑾集团掌权","stage":"s4","category":"政治","emperor":"正德帝","location":"北京","people":["朱厚照","刘瑾","李东阳"],"institutions":["司礼监","内阁","厂卫"],"confidence":"高","detailUrl":"assets/data/event-details/e046.json","eraYear":"正德元年","cause":"正德帝信任东宫旧宦官并厌恶内阁约束。","impact":"再次显示宦官权力根源在皇帝授权与奏章通道，而非独立制度。"},{"id":"e047","year":1510,"date":"1510年","eraDate":"正德五年","title":"安化王叛乱与刘瑾伏诛","stage":"s4","category":"政治","emperor":"正德帝","location":"宁夏／北京","people":["朱厚照","刘瑾","张永","杨一清"],"institutions":["宗藩制度","司礼监"],"confidence":"高","detailUrl":"assets/data/event-details/e047.json","eraYear":"正德五年","cause":"宗室朱寘鐇借反刘瑾名义起兵，朝廷内部亦积累清算刘瑾的力量。","impact":"宦官专权阶段结束，但皇帝绕开常规官僚的统治方式并未改变。"},{"id":"e048","year":1511,"date":"1511—1512年","eraDate":"正德六年至七年","title":"北直隶、山东等地民变扩大","stage":"s4","category":"社会","emperor":"正德帝","location":"华北","people":["朱厚照"],"institutions":["地方军","漕运沿线治理"],"confidence":"中","detailUrl":"assets/data/event-details/e048.json","eraYear":"正德六年","cause":"灾荒、赋役、治安恶化与流动人口聚集加剧社会矛盾。","impact":"暴露京畿周边基层治理和军事动员的脆弱性。"},{"id":"e049","year":1517,"date":"1517年","eraDate":"正德十二年","title":"葡萄牙使团抵达广州","stage":"s4","category":"对外关系","emperor":"正德帝","location":"广州","people":["朱厚照"],"institutions":["市舶体系","朝贡体系"],"confidence":"高","detailUrl":"assets/data/event-details/e049.json","eraYear":"正德十二年","cause":"葡萄牙海上扩张进入南海并寻求与明朝直接贸易和外交。","impact":"标志欧洲海权直接进入明朝沿海秩序。"},{"id":"e050","year":1519,"date":"1519年","eraDate":"正德十四年","title":"宁王之乱","stage":"s4","category":"战争","emperor":"正德帝","location":"江西","people":["王守仁","朱厚照","朱宸濠"],"institutions":["宗藩制度","地方军","巡抚"],"confidence":"高","detailUrl":"assets/data/event-details/e050.json","eraYear":"正德十四年","cause":"宁王朱宸濠长期扩张护卫和地方势力，并利用朝廷政治混乱谋反。","impact":"证明地方文官可动员军事资源，也进一步削弱有兵权的宗藩。"},{"id":"e051","year":1521,"date":"1521年","eraDate":"正德十六年","title":"正德帝无嗣而亡、嘉靖帝入继","stage":"s4","category":"政权更替","emperor":"嘉靖帝","location":"北京","people":["朱厚照","朱厚熜","杨廷和"],"institutions":["皇位继承","宗法礼制"],"confidence":"高","detailUrl":"assets/data/event-details/e051.json","eraYear":"正德十六年","cause":"正德帝去世且无子，皇位需从旁支宗室选择继承人。","impact":"继承方式直接引发如何尊奉嘉靖生父的大礼议。"},{"id":"e052","year":1521,"date":"1521—1524年","eraDate":"正德十六年至嘉靖三年","title":"大礼议","stage":"s4","category":"政治","emperor":"嘉靖帝","location":"北京","people":["朱厚熜","杨廷和","张璁","桂萼"],"institutions":["礼部","内阁","宗庙礼制"],"confidence":"高","detailUrl":"assets/data/event-details/e052.json","eraYear":"正德十六年","cause":"嘉靖帝坚持尊生父为皇考，杨廷和等主张按过继礼尊孝宗为父。","impact":"重组嘉靖朝政治联盟，并强化皇帝对礼制解释和官僚任免的控制。"},{"id":"e053","year":1524,"date":"1524年","eraDate":"嘉靖三年","title":"左顺门哭谏与廷杖","stage":"s4","category":"政治","emperor":"嘉靖帝","location":"北京左顺门","people":["朱厚熜","杨慎"],"institutions":["廷杖","科道言官","锦衣卫"],"confidence":"高","detailUrl":"assets/data/event-details/e053.json","eraYear":"嘉靖三年","cause":"大批官员反对大礼议结论，要求皇帝改变尊亲方案。","impact":"成为皇帝以身体惩罚制服集体谏诤的标志性事件。"},{"id":"e054","year":1542,"date":"1542年","eraDate":"嘉靖二十一年","title":"壬寅宫变","stage":"s4","category":"政治","emperor":"嘉靖帝","location":"北京宫城","people":["朱厚熜"],"institutions":["内廷","宫女制度"],"confidence":"中","detailUrl":"assets/data/event-details/e054.json","eraYear":"嘉靖二十一年","cause":"宫女长期遭受严酷役使，宫廷内部积怨。","impact":"揭示高度封闭宫廷中的暴力关系，但不宜被夸大为国家政治转折点。"},{"id":"e055","year":1550,"date":"1550年","eraDate":"嘉靖二十九年","title":"庚戌之变","stage":"s4","category":"战争","emperor":"嘉靖帝","location":"北京周边","people":["朱厚熜","严嵩","仇鸾"],"institutions":["九边","京营","互市"],"confidence":"高","detailUrl":"assets/data/event-details/e055.json","eraYear":"嘉靖二十九年","cause":"俺答汗要求互市未果，蒙古军突破边墙并深入京畿。","impact":"暴露九边、京营和互市政策问题，推动后续边防重整。"},{"id":"e056","year":1556,"date":"1556年","eraDate":"嘉靖三十五年","title":"嘉靖大地震","stage":"s4","category":"灾害","emperor":"嘉靖帝","location":"陕西、山西、河南等地","people":["朱厚熜"],"institutions":["赈灾","地方财政"],"confidence":"中","detailUrl":"assets/data/event-details/e056.json","eraYear":"嘉靖三十五年","cause":"华山地区发生强烈地震。","impact":"是明代最严重自然灾害之一；传统死亡数字需要谨慎对待。"},{"id":"e057","year":1557,"date":"1557年前后","eraDate":"嘉靖三十六年前后","title":"葡萄牙人取得澳门居留地","stage":"s4","category":"对外关系","emperor":"嘉靖帝","location":"澳门","people":["朱厚熜"],"institutions":["广州海贸","澳门地方管理"],"confidence":"中","detailUrl":"assets/data/event-details/e057.json","eraYear":"嘉靖三十六年","cause":"中葡走私、缉私合作和广州贸易逐步形成现实妥协。","impact":"建立延续数百年的中欧贸易与文化交流门户。"},{"id":"e058","year":1561,"date":"1561年","eraDate":"嘉靖四十年","title":"戚继光台州抗倭战役","stage":"s4","category":"战争","emperor":"嘉靖帝","location":"浙江台州","people":["戚继光","胡宗宪","俞大猷"],"institutions":["戚家军","募兵制","海防"],"confidence":"高","detailUrl":"assets/data/event-details/e058.json","eraYear":"嘉靖四十年","cause":"东南沿海走私集团、倭寇和地方武装长期冲击州县。","impact":"体现募兵、严格训练和地方军政协作相对卫所旧制的优势。"},{"id":"e059","year":1562,"date":"1562年","eraDate":"嘉靖四十一年","title":"严嵩失势","stage":"s4","category":"政治","emperor":"嘉靖帝","location":"北京","people":["严嵩","严世蕃","徐阶","朱厚熜"],"institutions":["内阁","都察院"],"confidence":"高","detailUrl":"assets/data/event-details/e059.json","eraYear":"嘉靖四十一年","cause":"严嵩父子长期掌权引发官僚反弹，皇帝信任转移。","impact":"内阁首辅更替并未改变嘉靖帝最终裁决一切的权力结构。"},{"id":"e060","year":1566,"date":"1566年","eraDate":"嘉靖四十五年","title":"海瑞上《治安疏》","stage":"s4","category":"政治","emperor":"嘉靖帝","location":"北京","people":["海瑞","朱厚熜","徐阶"],"institutions":["言官","诏狱"],"confidence":"高","detailUrl":"assets/data/event-details/e060.json","eraYear":"嘉靖四十五年","cause":"长期斋醮、财政负担和官僚失序引发批评。","impact":"成为明代言官政治与道德批判的象征，但其实际政策效果有限。"},{"id":"e061","year":1567,"date":"1567年","eraDate":"隆庆元年","title":"隆庆开关","stage":"s5","category":"财政经济","emperor":"隆庆帝","location":"福建月港","people":["朱载坖","高拱","徐阶"],"institutions":["月港","海禁","市舶"],"confidence":"高","detailUrl":"assets/data/event-details/e061.json","eraYear":"隆庆元年","cause":"长期海禁难以阻止走私，沿海贸易需求和财政利益持续扩大。","impact":"促进白银流入、沿海商业和全球贸易联系。"},{"id":"e062","year":1571,"date":"1571年","eraDate":"隆庆五年","title":"俺答封贡与隆庆和议","stage":"s5","category":"对外关系","emperor":"隆庆帝","location":"北部边境","people":["朱载坖","高拱","张居正","戚继光"],"institutions":["封贡","互市","九边"],"confidence":"高","detailUrl":"assets/data/event-details/e062.json","eraYear":"隆庆五年","cause":"长期战争和私下贸易表明彻底封锁蒙古并不可行。","impact":"北部大规模冲突明显减少，为边防和财政带来数十年缓冲。"},{"id":"e063","year":1572,"date":"1572年","eraDate":"隆庆六年","title":"万历帝即位与张居正辅政","stage":"s5","category":"政治","emperor":"万历帝","location":"北京","people":["朱翊钧","张居正","冯保"],"institutions":["内阁","司礼监","后宫辅政"],"confidence":"高","detailUrl":"assets/data/event-details/e063.json","eraYear":"隆庆六年","cause":"隆庆帝去世，十岁的朱翊钧继位。","impact":"改革依赖皇帝年幼期的特殊权力组合，日后也因此遭到反弹。"},{"id":"e064","year":1578,"date":"1578年前后","eraDate":"万历六年前后","title":"全国清丈田亩推进","stage":"s5","category":"财政经济","emperor":"万历帝","location":"全国","people":["张居正","朱翊钧"],"institutions":["清丈","鱼鳞图册","考成法"],"confidence":"中","detailUrl":"assets/data/event-details/e064.json","eraYear":"万历六年","cause":"隐田、税额失真和地方拖欠削弱中央财政。","impact":"增加财政可见度，但执行差异、权势转嫁和数据可靠性仍有争议。"},{"id":"e065","year":1581,"date":"1581年前后","eraDate":"万历九年前后","title":"一条鞭法在全国推广","stage":"s5","category":"财政经济","emperor":"万历帝","location":"全国","people":["张居正","朱翊钧"],"institutions":["一条鞭法","户部","里甲"],"confidence":"中","detailUrl":"assets/data/event-details/e065.json","eraYear":"万历九年","cause":"赋役项目复杂、实物运输低效，白银流通不断扩大。","impact":"强化白银对国家财政和民生的影响，但并非全国完全一致的一次性改革。"},{"id":"e066","year":1582,"date":"1582年","eraDate":"万历十年","title":"张居正去世与改革反攻倒算","stage":"s5","category":"政治","emperor":"万历帝","location":"北京","people":["张居正","朱翊钧","冯保"],"institutions":["内阁","考成法"],"confidence":"高","detailUrl":"assets/data/event-details/e066.json","eraYear":"万历十年","cause":"张居正长期集权施政积累官僚怨恨，万历帝成年后希望摆脱控制。","impact":"显示制度改革对个人权力和宫廷联盟依赖过强。"},{"id":"e067","year":1583,"date":"1583年","eraDate":"万历十一年","title":"利玛窦进入肇庆","stage":"s5","category":"文化科技","emperor":"万历帝","location":"广东肇庆","people":["利玛窦","朱翊钧"],"institutions":["耶稣会","地方官府"],"confidence":"高","detailUrl":"assets/data/event-details/e067.json","eraYear":"万历十一年","cause":"耶稣会寻求在中国建立长期传教和知识交流据点。","impact":"推动地图、数学、天文与宗教思想的跨文化交流。"},{"id":"e068","year":1592,"date":"1592年","eraDate":"万历二十年","title":"宁夏哱拜之乱","stage":"s5","category":"战争","emperor":"万历帝","location":"宁夏","people":["朱翊钧","李如松","魏学曾"],"institutions":["九边","军饷","总督"],"confidence":"高","detailUrl":"assets/data/event-details/e068.json","eraYear":"万历二十年","cause":"边镇军饷拖欠、将领矛盾和哱拜集团控制军队。","impact":"成为万历“三大征”之一，消耗财政并暴露边镇军饷问题。"},{"id":"e069","year":1592,"date":"1592—1598年","eraDate":"万历二十年至二十六年","title":"援朝抗倭战争","stage":"s5","category":"战争","emperor":"万历帝","location":"朝鲜半岛","people":["朱翊钧","李如松","沈惟敬","李舜臣","丰臣秀吉"],"institutions":["辽东军","朝贡体系","兵部"],"confidence":"高","detailUrl":"assets/data/event-details/e069.json","eraYear":"万历二十年","cause":"丰臣秀吉入侵朝鲜并威胁明朝辽东与朝贡秩序。","impact":"维持朝鲜政权，但明朝承担巨额军费和辽东兵力损耗。"},{"id":"e070","year":1596,"date":"1596年起","eraDate":"万历二十四年起","title":"矿监税使大规模派出","stage":"s5","category":"财政经济","emperor":"万历帝","location":"全国矿区与商税地区","people":["朱翊钧","陈增"],"institutions":["矿监税使","司礼监","户部"],"confidence":"高","detailUrl":"assets/data/event-details/e070.json","eraYear":"万历二十四年","cause":"宫廷财政需求增加，皇帝希望绕过常规财政机构直接获得收入。","impact":"破坏中央与地方、户部与内廷之间的财政信任。"},{"id":"e071","year":1600,"date":"1590—1600年","eraDate":"万历十八年至二十八年","title":"播州之役结束","stage":"s5","category":"战争","emperor":"万历帝","location":"播州／贵州四川交界","people":["朱翊钧","李化龙","杨应龙"],"institutions":["土司","改土归流","总督"],"confidence":"高","detailUrl":"assets/data/event-details/e071.json","eraYear":"万历十八年","cause":"播州杨氏土司与中央、邻近地方势力矛盾长期升级。","impact":"完成万历三大征之一，也加重财政和西南军政负担。"},{"id":"e072","year":1601,"date":"1601年","eraDate":"万历二十九年","title":"朱常洛被立为皇太子","stage":"s5","category":"政治","emperor":"万历帝","location":"北京","people":["朱翊钧","朱常洛","朱常洵","申时行","王锡爵"],"institutions":["皇储制度","内阁","言官"],"confidence":"高","detailUrl":"assets/data/event-details/e072.json","eraYear":"万历二十九年","cause":"万历帝长期希望立朱常洵，引发持续“国本之争”。","impact":"长期争储严重损耗君臣关系，并成为晚万历政治停滞的重要组成。"},{"id":"e073","year":1615,"date":"1615年","eraDate":"万历四十三年","title":"梃击案","stage":"s5","category":"政治","emperor":"万历帝","location":"北京东宫","people":["朱常洛","朱翊钧"],"institutions":["东宫","刑部","党争"],"confidence":"中","detailUrl":"assets/data/event-details/e073.json","eraYear":"万历四十三年","cause":"一名男子持木棍闯入太子居所，案件被卷入长期争储疑云。","impact":"成为晚明“三案”之一，进一步加深官僚阵营猜疑。"},{"id":"e074","year":1616,"date":"1616—1618年","eraDate":"万历四十四年至四十六年","title":"后金建立并以“七大恨”攻明","stage":"s5","category":"战争","emperor":"万历帝","location":"建州、辽东","people":["努尔哈赤","朱翊钧","李成梁"],"institutions":["辽东都司","八旗","边贸"],"confidence":"高","detailUrl":"assets/data/event-details/e074.json","eraYear":"万历四十四年","cause":"努尔哈赤统一建州女真后，与明朝在边贸、部族控制和军事冲突上的矛盾升级。","impact":"辽东成为吞噬军费、兵力和政治注意力的长期战场。"},{"id":"e075","year":1619,"date":"1619年","eraDate":"万历四十七年","title":"萨尔浒之战","stage":"s5","category":"战争","emperor":"万历帝","location":"萨尔浒及抚顺周边","people":["努尔哈赤","杨镐","杜松","刘綎"],"institutions":["辽东军","八旗","辽饷"],"confidence":"高","detailUrl":"assets/data/event-details/e075.json","eraYear":"万历四十七年","cause":"明廷试图以多路大军一次性消灭后金。","impact":"明朝从战略进攻转为长期防御，辽饷压力急剧增加。"},{"id":"e076","year":1620,"date":"1620年","eraDate":"万历四十八年／泰昌元年","title":"万历、泰昌、天启三帝递嬗与红丸案","stage":"s6","category":"政权更替","emperor":"天启帝","location":"北京","people":["朱翊钧","朱常洛","朱由校","李可灼"],"institutions":["皇位继承","内阁","司礼监"],"confidence":"中","detailUrl":"assets/data/event-details/e076.json","eraYear":"万历四十八年","cause":"万历帝去世后，光宗朱常洛即位不久即病重。","impact":"红丸案与移宫案加剧东林及其反对者之间的政治分裂。"},{"id":"e077","year":1621,"date":"1621年","eraDate":"天启元年","title":"沈阳、辽阳失守","stage":"s6","category":"战争","emperor":"天启帝","location":"辽东","people":["努尔哈赤","熊廷弼","朱由校"],"institutions":["辽东经略","辽饷","八旗"],"confidence":"高","detailUrl":"assets/data/event-details/e077.json","eraYear":"天启元年","cause":"萨尔浒后明军防线和将领体系持续失序，后金扩大攻势。","impact":"人口、军队和财政损失加重，防线逐步退向辽西走廊。"},{"id":"e078","year":1624,"date":"1624—1626年","eraDate":"天启四年至六年","title":"魏忠贤掌权与东林党祸","stage":"s6","category":"政治","emperor":"天启帝","location":"北京及全国","people":["魏忠贤","朱由校","杨涟","左光斗"],"institutions":["司礼监","东厂","锦衣卫","东林党"],"confidence":"高","detailUrl":"assets/data/event-details/e078.json","eraYear":"天启四年","cause":"天启帝疏于日常政务，魏忠贤与客氏控制宫廷通道并打击反对者。","impact":"政治清洗破坏官僚合作，但把明亡简单归因于单一宦官同样失真。"},{"id":"e079","year":1626,"date":"1626年","eraDate":"天启六年","title":"宁远之战","stage":"s6","category":"战争","emperor":"天启帝","location":"宁远","people":["袁崇焕","努尔哈赤","孙承宗"],"institutions":["关宁防线","红夷大炮"],"confidence":"高","detailUrl":"assets/data/event-details/e079.json","eraYear":"天启六年","cause":"后金试图突破辽西防线，明廷内部对守关还是守辽存在争论。","impact":"证明坚城、火器和稳定指挥可遏制后金，但无法根本解决辽东战略困境。"},{"id":"e080","year":1626,"date":"1626年五月","eraDate":"天启六年五月","title":"王恭厂大爆炸","stage":"s6","category":"灾害","emperor":"天启帝","location":"北京","people":["朱由校"],"institutions":["火药军器储存","城市管理"],"confidence":"中","detailUrl":"assets/data/event-details/e080.json","eraYear":"天启六年","cause":"北京西南王恭厂附近发生原因至今未明的大规模爆炸。","impact":"成为晚明城市灾害史的重要事件；具体成因和伤亡数字均不宜武断。"},{"id":"e081","year":1627,"date":"1627年","eraDate":"天启七年","title":"崇祯帝继位并清除魏忠贤集团","stage":"s6","category":"政治","emperor":"崇祯帝","location":"北京","people":["朱由检","魏忠贤"],"institutions":["司礼监","东厂","内阁"],"confidence":"高","detailUrl":"assets/data/event-details/e081.json","eraYear":"天启七年","cause":"天启帝无成年子嗣去世，弟朱由检继位。","impact":"新帝取得道德声望，但频繁更换大臣和高度猜疑随后削弱决策稳定。"},{"id":"e082","year":1628,"date":"1628年起","eraDate":"崇祯元年起","title":"陕北民变扩展","stage":"s6","category":"社会","emperor":"崇祯帝","location":"陕西及华北","people":["李自成","张献忠","朱由检","洪承畴"],"institutions":["驿站裁撤","剿抚政策","地方军"],"confidence":"高","detailUrl":"assets/data/event-details/e082.json","eraYear":"崇祯元年","cause":"旱灾、饥荒、军饷裁撤、赋税和基层治理失败共同作用。","impact":"与辽东战争争夺财政和兵力，使明朝陷入内外两线危机。"},{"id":"e083","year":1629,"date":"1629—1630年","eraDate":"崇祯二年至三年","title":"己巳之变与袁崇焕被杀","stage":"s6","category":"战争","emperor":"崇祯帝","location":"北京周边","people":["朱由检","袁崇焕","皇太极","祖大寿"],"institutions":["关宁防线","勤王军","诏狱"],"confidence":"中","detailUrl":"assets/data/event-details/e083.json","eraYear":"崇祯二年","cause":"皇太极绕过关宁防线，自蒙古方向入塞。","impact":"暴露边防体系可被迂回，也显示崇祯决策中的信息失真和信任崩解。"},{"id":"e084","year":1633,"date":"1633年","eraDate":"崇祯六年","title":"料罗湾海战","stage":"s6","category":"战争","emperor":"崇祯帝","location":"福建料罗湾","people":["郑芝龙","朱由检"],"institutions":["福建水师","海商集团"],"confidence":"高","detailUrl":"assets/data/event-details/e084.json","eraYear":"崇祯六年","cause":"荷兰东印度公司试图以武力迫使明朝开放更有利贸易条件，并联合海上武装。","impact":"显示晚明地方海商军事集团已成为国家海防的重要力量。"},{"id":"e085","year":1636,"date":"1636年","eraDate":"崇祯九年","title":"皇太极改国号为大清","stage":"s6","category":"政权更替","emperor":"崇祯帝","location":"盛京","people":["皇太极","朱由检"],"institutions":["八旗","清朝中央机构"],"confidence":"高","detailUrl":"assets/data/event-details/e085.json","eraYear":"崇祯九年","cause":"后金已吸收蒙古势力并建立更复杂的多族政治军事组织。","impact":"明清战争从边疆冲突转为争夺天下合法性的战争。"},{"id":"e086","year":1641,"date":"1641年","eraDate":"崇祯十四年","title":"李自成攻占洛阳","stage":"s6","category":"战争","emperor":"崇祯帝","location":"洛阳","people":["李自成","朱常洵","朱由检"],"institutions":["宗藩制度","地方军"],"confidence":"高","detailUrl":"assets/data/event-details/e086.json","eraYear":"崇祯十四年","cause":"民变军在河南灾荒与明军调度失衡中重新壮大。","impact":"李自成获得巨大声望与资源，民变开始向建立政权发展。"},{"id":"e087","year":1642,"date":"1642年","eraDate":"崇祯十五年","title":"松锦之战失败","stage":"s6","category":"战争","emperor":"崇祯帝","location":"松山、锦州","people":["洪承畴","祖大寿","皇太极","朱由检"],"institutions":["关宁防线","辽饷","八旗"],"confidence":"高","detailUrl":"assets/data/event-details/e087.json","eraYear":"崇祯十五年","cause":"明廷试图解除锦州之围并维持辽西走廊。","impact":"关外主力与辽西防线遭到致命打击，山海关成为最后关键屏障。"},{"id":"e088","year":1642,"date":"1642年","eraDate":"崇祯十五年","title":"开封决河与城市毁灭","stage":"s6","category":"灾害","emperor":"崇祯帝","location":"开封","people":["李自成","朱由检"],"institutions":["河防","地方军","赈灾"],"confidence":"中","detailUrl":"assets/data/event-details/e088.json","eraYear":"崇祯十五年","cause":"明军与李自成军长期围攻对峙，黄河堤防被人为破坏；具体责任存在争议。","impact":"战争、灾害与治理崩溃相互放大，是晚明社会灾难的典型。"},{"id":"e089","year":1644,"date":"1644年正月—三月","eraDate":"崇祯十七年正月—三月","title":"大顺建立与北京陷落","stage":"s6","category":"政权更替","emperor":"崇祯帝","location":"西安、北京","people":["李自成","朱由检","吴三桂"],"institutions":["大顺政权","北京中央政府","勤王体系"],"confidence":"高","detailUrl":"assets/data/event-details/e089.json","eraYear":"崇祯十七年","cause":"李自成军控制陕西、山西并向京师推进，明朝财政和勤王体系失灵。","impact":"出现大顺、清、南明及地方军事集团并存的权力真空。"},{"id":"e090","year":1644,"date":"1644年四月—五月","eraDate":"崇祯十七年四月—五月","title":"山海关之战与清军入关","stage":"s6","category":"战争","emperor":"南明弘光帝","location":"山海关、北京","people":["吴三桂","李自成","多尔衮"],"institutions":["山海关守军","八旗","大顺军"],"confidence":"高","detailUrl":"assets/data/event-details/e090.json","eraYear":"崇祯十七年","cause":"吴三桂与大顺冲突，清摄政王多尔衮寻求进入中原的机会。","impact":"明亡后的内战转化为清朝争夺全国统治的战争。"},{"id":"e091","year":1644,"date":"1644年五月","eraDate":"崇祯十七年五月","title":"南京弘光政权建立","stage":"s6","category":"政权更替","emperor":"弘光帝","location":"南京","people":["朱由崧","史可法","马士英"],"institutions":["南京六部","江北四镇","南明"],"confidence":"高","detailUrl":"assets/data/event-details/e091.json","eraYear":"崇祯十七年","cause":"北京陷落后，南京官员和军镇需要建立新的明朝中央权威。","impact":"保留明朝法统，但内部拥立争议、军镇分裂和财政不足削弱北伐与防御。"},{"id":"e092","year":1645,"date":"1645年四月—五月","eraDate":"弘光元年四月—五月","title":"扬州失守与南京弘光政权覆亡","stage":"s6","category":"战争","emperor":"弘光帝","location":"扬州、南京","people":["史可法","朱由崧","多铎","马士英"],"institutions":["江北四镇","清军八旗","南明"],"confidence":"高","detailUrl":"assets/data/event-details/e092.json","eraYear":"弘光元年","cause":"清军南下，弘光朝内部军镇和中央缺乏有效协同。","impact":"江南权力结构迅速重组，并引发持续抵抗、屠杀记忆和社会震荡。"},{"id":"e093","year":1645,"date":"1645—1646年","eraDate":"弘光元年至隆武二年","title":"隆武政权建立与覆亡","stage":"s6","category":"政权更替","emperor":"隆武帝","location":"福州、福建","people":["朱聿键","郑芝龙","郑成功","黄道周"],"institutions":["南明","郑氏海商军政集团"],"confidence":"高","detailUrl":"assets/data/event-details/e093.json","eraYear":"弘光元年","cause":"南京失守后，福建士绅和郑芝龙集团拥立唐王朱聿键。","impact":"显示南明皇权严重依赖地区军事集团，中央与军镇目标并不一致。"},{"id":"e094","year":1646,"date":"1646年起","eraDate":"隆武二年（永历帝即位，翌年改元永历）","title":"永历政权成立","stage":"s6","category":"政权更替","emperor":"永历帝","location":"肇庆、桂林及西南","people":["朱由榔","瞿式耜","李定国","孙可望"],"institutions":["南明","西南军镇"],"confidence":"高","detailUrl":"assets/data/event-details/e094.json","eraYear":"隆武二年","cause":"隆武覆亡后，两广和西南明朝官员另立桂王朱由榔。","impact":"其后与大西军余部合作，使抗清战争延续十余年。"},{"id":"e095","year":1662,"date":"1652—1662年","eraDate":"永历六年至十六年","title":"西南反攻、败退缅甸与永历帝被杀","stage":"s6","category":"战争","emperor":"永历帝","location":"广西、云贵、缅甸、昆明","people":["朱由榔","李定国","孙可望","吴三桂","郑成功"],"institutions":["南明","大西军余部","清军绿营"],"confidence":"高","detailUrl":"assets/data/event-details/e095.json","eraYear":"永历六年","cause":"大西军余部与永历朝联合后曾取得反攻成果，但内部矛盾和清军持续推进削弱抵抗。","impact":"1662比1644更适合作为南明政治史终点；郑氏势力仍在台湾继续奉明正朔一段时期。"}],"source_catalog":{"MINGSHI":{"label":"《明史》全文","url":"https://zh.wikisource.org/zh/明史","kind":"清修正史"},"MINGSHILU":{"label":"中央研究院汉籍全文数据库","url":"https://www1.ihp.sinica.edu.tw/Research/Groups/scriptaSinica","kind":"《明实录》等全文检索入口"},"CAMBRIDGE":{"label":"《剑桥中国明代史》","url":"https://books.google.com/books/about/剑桥中国明代史_1368_1644年.html?id=XA8i0gEACAAJ","kind":"现代综合研究"},"CAMBRIDGE_SM":{"label":"The Southern Ming, 1644–1662","url":"https://www.cambridge.org/core/books/abs/cambridge-history-of-china/southern-ming-16441662/97FA570559404A627906FBF78D0C3A09","kind":"南明专题研究"},"TIMELINE":{"label":"Ming dynasty chronology","url":"https://en.wikipedia.org/wiki/Timeline_of_the_Ming_dynasty","kind":"年代交叉检查入口"},"CBDB":{"label":"中国历代人物传记资料库","url":"https://cbdb.hsites.harvard.edu/","kind":"人物、官职与关系数据"},"WEISO":{"label":"《明实录》卫所事件地图","url":"https://gis.rchss.sinica.edu.tw/weiso-event/","kind":"军事地理检索"},"DPM":{"label":"故宫博物院宫廷世系","url":"https://www.dpm.org.cn/court/lineages.html","kind":"帝系与宫廷资料"},"MET":{"label":"Met Museum: Ming Dynasty","url":"https://www.metmuseum.org/essays/ming-dynasty-1368-1644","kind":"艺术与物质文化"}}}