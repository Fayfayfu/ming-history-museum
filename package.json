    "verify:people-timeline": "node scripts/verify_ming_people_timeline.mjs",
    "verify:people-timeline-unit": "node --test scripts/lib/people_timeline.test.mjs scripts/verify_ming_people_timeline.test.mjs",
    "verify:people-timeline-variants-unit": "node --test scripts/lib/people_timeline_variants.test.mjs",
    "verify:people-timeline-page": "node scripts/verify_ming_people_timeline_page.mjs",
    "verify:people-timeline-variants-page": "node scripts/verify_ming_people_timeline_variants_page.mjs",
