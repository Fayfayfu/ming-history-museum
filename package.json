    "verify:navigation-type": "node scripts/verify_museum_nav_typography.mjs",
    "verify:deploy": "node scripts/verify_vercel_bundle.mjs",
    "verify": "npm run verify:people-timeline && npm run verify:people-timeline-unit && npm run verify:people-timeline-variants-unit && node --test scripts/lib/ming_reign_year.test.mjs && node scripts/verify_ming_museum.mjs && npm run verify:people-timeline-page && npm run verify:people-timeline-variants-page && npm run verify:people-timeline-doubleclick-page && node scripts/verify_ming_reign_year_page.mjs"
